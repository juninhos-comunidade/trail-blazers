# PostgreSQL (usado pelo docker-compose e pelo Prisma)
POSTGRES_USER=trailblazers
POSTGRES_PASSWORD=trailblazers
POSTGRES_DB=trailblazers
POSTGRES_PORT=5432

# Conexão do Prisma
DATABASE_URL="postgresql://trailblazers:trailblazers@localhost:5432/trailblazers?schema=public"

GITHUB_CLIENT_ID=Ov23lixxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Gere com: openssl rand -hex 32  (mínimo 32 caracteres)
JWT_SECRET=troque-por-um-segredo-com-no-minimo-32-chars
JWT_EXPIRES_IN=1d

# Destino do redirect após o login com sucesso
FRONTEND_URL=http://localhost:3001
# Chave AES-256 (32 bytes em hex) para criptografar o token do GitHub
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=troque-por-64-caracteres-hexadecimais-gerados-com-openssl-rand
